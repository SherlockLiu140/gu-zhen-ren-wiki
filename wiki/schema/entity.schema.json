{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/wiki-entity.json",
  "title": "蛊真人 Wiki 实体",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "type",
    "name",
    "aliases",
    "summary",
    "status",
    "scope",
    "attributes",
    "facts",
    "relations",
    "tags"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": {
      "type": "string",
      "pattern": "^(cultivation|character|gu|beast|location|faction|gu-house)\\.[a-z0-9-]+$"
    },
    "type": {
      "enum": ["cultivation", "character", "gu", "beast", "location", "faction", "gu-house"]
    },
    "name": { "type": "string", "minLength": 1 },
    "aliases": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "summary": { "type": "string", "minLength": 1 },
    "status": { "type": "string", "pattern": "^(verified-volume-[1-9][0-9]*|draft)$" },
    "scope": {
      "type": "object",
      "description": "本条目核对到哪个位置。volume 是已覆盖的最高卷，引用可以来自该卷及更早的卷；maxChapter 是已核对的最高章节号，须落在 volume 的区间内。",
      "additionalProperties": false,
      "required": ["volume", "maxChapter"],
      "properties": {
        "volume": { "type": "integer", "minimum": 1, "description": "已核对的最高卷号" },
        "maxChapter": { "type": "integer", "minimum": 1, "description": "已核对的最高章节号" }
      }
    },
    "firstMention": { "$ref": "#/$defs/chapterReference" },
    "firstAppearance": { "$ref": "#/$defs/chapterReference" },
    "attributes": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "facts": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/sourcedText" }
    },
    "relations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["target", "label", "sources"],
        "properties": {
          "target": { "type": "string" },
          "label": { "type": "string", "minLength": 1 },
          "sources": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "integer", "minimum": 1 }
          }
        }
      }
    },
    "tags": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
  },
  "$defs": {
    "chapterReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["chapterId"],
      "properties": { "chapterId": { "type": "integer", "minimum": 1 } }
    },
    "sourcedText": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "sources"],
      "properties": {
        "text": { "type": "string", "minLength": 1 },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "integer", "minimum": 1 }
        }
      }
    }
  }
}
