  "attributes": {
    "位置": "三叉山",
    "分支": "犬王、信王、爆王",
    "前身": "六转蛊仙福地"
  },
  "facts": [
    {
      "text": "传承现世时黄、蓝、红三道光柱冲天；黄柱为犬王传承，需至少炼化一转驭犬蛊；蓝柱为信王传承，需拥有纸鹤蛊；红柱为爆王传承，需掌握爆蛋蛊。",
      "sources": [
        324
      ]
    },
    {
      "text": "三王传承之地就是当年六转蛊仙的福地，消息传出后世人哗然。",
      "sources": [
        326
      ]
    },
    {
      "text": "方源在商家城时刻意选择力道修行，正是为几年后的三王传承布局。",
      "sources": [
        275
      ]
    }
  ],
